{
  "name": "@tokcalc/mcp-server",
  "version": "0.2.0",
  "mcpName": "io.github.stevecrates489-commits/tokcalc",
  "description": "tokcalc MCP server — open-source LLM serving capacity planner for AI agents. v0.2.0: stdio + stateless HTTP transport with bearer API key auth + KV-backed rate limiting + public hosted endpoint. 7 read-only tools: estimate_capacity, compare_gpus, recommend_topology, estimate_api_vs_self_host, list_models, list_gpus, get_mlperf_benchmarks.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "bin": {
    "tokcalc-mcp": "./dist/index.js",
    "tokcalc-mcp-server": "./dist/index.js",
    "mcp-server": "./dist/index.js",
    "tokcalc-mcp-http": "./dist/http.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "inference",
    "capacity-planner",
    "gpu",
    "vllm",
    "h100",
    "h200",
    "tokcalc"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stevecrates489-commits/tokcalc"
  },
  "homepage": "https://tokcalc.vercel.app",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server.js": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@upstash/ratelimit": "^2.0.3",
    "@upstash/redis": "^1.34.0",
    "zod-to-json-schema": "^3.25.2"
  }
}